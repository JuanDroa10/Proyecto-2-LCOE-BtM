 """
+from . import xm_prices  # no cycle: xm_prices only imports http_utils, not this module
 
 # Location name (see src/locations.py) -> SDL (regional distribution utility) code.
 LOCATION_SDL = {
     "Bogota": "ENEL-CODENSA",
     "Medellin": "EPM",
-    "Cali": "CELSIA",
